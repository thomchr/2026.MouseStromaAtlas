library(data.table)
library(tidyr)
library(dplyr)
library(ggplot2)
library(RColorBrewer)
library(patchwork)
library(readxl)
library(purrr)
library(scales)
library(grid)
library(gridExtra)
library(gtable)
library(cowplot)

### Brian GSEA from sc object ##

#initial analysis on Dropbox
setwd("/Users/thomc/Dropbox/2026 Dulmovits Single Cell Bone Marrow/251209.GSEA.LastFig/")

# Specify the path to your Excel file
file <- "Summary of GSEA pathways to plot_CST.xlsx"

# Get the names of all sheets in the workbook
sheet_names <- excel_sheets(file)

# Output folder
dir.create("plots", showWarnings = FALSE)

# Loop over sheets
for (sheet in sheet_names) {
  
  # Read the sheet
  df <- read_excel(file, sheet = sheet)
  df$pval <- as.numeric(df$pval)
  
  # Expect columns: pathway, NES, pval
  df <- df %>% 
    mutate(
      color = ifelse(NES > 0, "red", "blue"),
      alpha_val = 1 - pval  # lower pval = stronger color
    )
  
  # -------- BAR PLOT --------
  p_bar <- ggplot(df, aes(x = NES, y = reorder(pathway, NES))) +
    geom_col(aes(fill = color, alpha = alpha_val)) +
    scale_fill_identity() +
    scale_alpha(range = c(0.2, 1)) +
    theme_bw() +
    labs(
      title = paste("GSEA Bar Plot -", sheet),
      x = "NES",
      y = ""
    ) +
    theme(
      plot.title = element_text(size = 18),
      axis.text = element_text(size = 12),
      axis.title = element_text(size = 14)
    )
  
  ggsave(
    filename = paste0("plots/", sheet, "_barplot.png"),
    plot = p_bar,
    width = 11, height = 7, dpi = 300
  )
  
  # -------- BUBBLE PLOT --------
  p_bubble <- ggplot(df, aes(
    x = NES,
    y = reorder(pathway, NES),
    size = -log10(pval),
    color = NES
  )) +
    geom_point(alpha = 0.8) +
    scale_color_gradient2(low = "blue", mid = "white", high = "red") +
    theme_bw() +
    labs(
      title = paste("GSEA Bubble Plot -", sheet),
      x = "NES",
      y = "",
      size = "-log10(pval)"
    ) +
    theme(
      plot.title = element_text(size = 18),
      axis.text = element_text(size = 12),
      axis.title = element_text(size = 14)
    )
  
  ggsave(
    filename = paste0("plots/", sheet, "_bubbleplot.png"),
    plot = p_bubble,
    width = 11, height = 7, dpi = 300
  )

  
  message("Saved bar + bubble plots for: ", sheet)
}

